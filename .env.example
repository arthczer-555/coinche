# Copier en .env.local et remplir avec les valeurs du projet Supabase
# (Dashboard > Project Settings > API). Sans ces variables, l'app reste un compteur 100 % local.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (publishable / anon). Jamais la clé service_role.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx

# Facultatif : mesure d'usage anonyme (PostHog, projet hébergé en UE). Sans clé, rien n'est envoyé.
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
